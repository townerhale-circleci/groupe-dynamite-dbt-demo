# Copy to `.env` and fill in real values. NEVER commit `.env`.
# The dbt profile (profiles.yml) reads ONLY these environment variables.

# --- Snowflake account / auth ---
DBT_SNOWFLAKE_ACCOUNT=your_account_locator.region      # e.g. ab12345.ca-central-1.aws
DBT_SNOWFLAKE_USER=GROUPE_DYNAMITE_DEMO_USER
DBT_SNOWFLAKE_PASSWORD=change_me
DBT_SNOWFLAKE_ROLE=GROUPE_DYNAMITE_DEMO_ROLE

# --- Warehouse / database / schema ---
DBT_SNOWFLAKE_WAREHOUSE=GROUPE_DYNAMITE_DEMO_WH
DBT_SNOWFLAKE_DATABASE=GROUPE_DYNAMITE_DEMO
# Target schema is created from DBT_SCHEMA (see profiles.yml generate_schema_name behaviour).
DBT_SCHEMA=ANALYTICS

# --- Optional dbt runtime knobs ---
DBT_THREADS=4

# =============================================================================
# CircleCI (.circleci/config.yml) variable reference — for local parity only.
# =============================================================================
# In CircleCI the Snowflake credentials above (DBT_SNOWFLAKE_ACCOUNT/USER/
# PASSWORD/ROLE/WAREHOUSE/DATABASE) are provided by the `snowflake-dbt-demo`
# CONTEXT and attached ONLY to jobs that need them — never committed here.
#
# DBT_SCHEMA is set by CI per job, not by you:
#   * PR builds  -> a disposable PR_<...> schema (scripts/resolve_pr_schema.py)
#   * main DEV   -> DBT_SCHEMA=DEV
#   * main PROD  -> DBT_SCHEMA=PROD   (after a manual approval hold)
#
# The PR schema resolver reads these CircleCI BUILT-IN vars (auto-populated by
# CircleCI at run time; do not set them yourself):
#   CIRCLE_PULL_REQUEST   # PR URL, e.g. https://github.com/org/repo/pull/42
#   CIRCLE_PR_NUMBER      # PR number (when available)
#   CIRCLE_BRANCH         # git branch
#   CIRCLE_BUILD_NUM      # build number (final fallback)
